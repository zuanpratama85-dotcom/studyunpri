{
  "expo": {
    "name": "StudyUnpri",
    "slug": "studyunpri",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E3A5F"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zuanpratama.studyunpri"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1E3A5F"
      },
      "package": "com.zuanpratama.studyunpri"
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": ["expo-image-picker"]
  }
}
